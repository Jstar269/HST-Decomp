 /* Return truth value of whether OP can be used as an operands
    where a register or 16 bit unsigned integer is needed.  */
 
+/* Return nonzero if OP is a CONST_INT of the form 2**n - 1 with
+   16 < n < 32: a mask Allegrex's ext can apply and andi cannot.  */
+
+int
+allegrex_low_mask_p (op)
+     rtx op;
+{
+  unsigned HOST_WIDE_INT v;
+  int n;
+
+  if (GET_CODE (op) != CONST_INT)
+    return 0;
+  v = INTVAL (op) & 0xffffffff;
+  n = exact_log2 (v + 1);
+  return n > 16 && n < 32;
+}
+
+/* Return truth value of whether OP can be the second operand of andsi3.  */
+
+int
+and_operand (op, mode)
+     rtx op;
+     enum machine_mode mode;
+{
+  if (TARGET_ALLEGREX_EXT && allegrex_low_mask_p (op))
+    return 1;
+  return uns_arith_operand (op, mode);
+}
+
 int
 uns_arith_operand (op, mode)
      rtx op;
