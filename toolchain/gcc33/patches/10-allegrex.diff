+;; Sign extension: seb, seh.
+
+(define_insn "extendqisi2_allegrex"
+  [(set (match_operand:SI 0 "register_operand" "=d")
+	(sign_extend:SI (match_operand:QI 1 "register_operand" "d")))]
+  "TARGET_ALLEGREX"
+  "seb\t%0,%1"
+  [(set_attr "type"	"arith")
+   (set_attr "mode"	"SI")])
+
+(define_insn "extendhisi2_allegrex"
+  [(set (match_operand:SI 0 "register_operand" "=d")
+	(sign_extend:SI (match_operand:HI 1 "register_operand" "d")))]
+  "TARGET_ALLEGREX"
+  "seh\t%0,%1"
+  [(set_attr "type"	"arith")
+   (set_attr "mode"	"SI")])
+
+;; Minimum and maximum.
+
+(define_expand "sminsi3"
+  [(set (match_operand:SI 0 "register_operand" "")
+	(smin:SI (match_operand:SI 1 "register_operand" "")
+		 (match_operand:SI 2 "register_operand" "")))]
+  "TARGET_ALLEGREX"
+  "")
+
+(define_insn "sminsi3_allegrex"
+  [(set (match_operand:SI 0 "register_operand" "=d")
+	(smin:SI (match_operand:SI 1 "register_operand" "d")
+		 (match_operand:SI 2 "register_operand" "d")))]
+  "TARGET_ALLEGREX"
+  "min\t%0,%1,%2"
+  [(set_attr "type"	"arith")
+   (set_attr "mode"	"SI")])
+
+(define_expand "smaxsi3"
+  [(set (match_operand:SI 0 "register_operand" "")
+	(smax:SI (match_operand:SI 1 "register_operand" "")
+		 (match_operand:SI 2 "register_operand" "")))]
+  "TARGET_ALLEGREX"
+  "")
+
+(define_insn "smaxsi3_allegrex"
+  [(set (match_operand:SI 0 "register_operand" "=d")
+	(smax:SI (match_operand:SI 1 "register_operand" "d")
+		 (match_operand:SI 2 "register_operand" "d")))]
+  "TARGET_ALLEGREX"
+  "max\t%0,%1,%2"
+  [(set_attr "type"	"arith")
+   (set_attr "mode"	"SI")])
+
+;; Absolute value: negate, then the maximum of the two.
+
+(define_expand "abssi2_allegrex"
+  [(set (match_operand:SI 0 "register_operand" "")
+	(abs:SI (match_operand:SI 1 "register_operand" "")))]
+  "TARGET_ALLEGREX"
+  "
+{
+  rtx t = gen_reg_rtx (SImode);
+  emit_insn (gen_negsi2 (t, operands[1]));
+  emit_insn (gen_smaxsi3 (operands[0], operands[1], t));
+  DONE;
+}")
+
+;; Bit-field extract and insert (-mext).
+
+(define_insn "extzv_allegrex_insn"
+  [(set (match_operand:SI 0 "register_operand" "=d")
+	(zero_extract:SI (match_operand:SI 1 "register_operand" "d")
+			 (match_operand:SI 2 "const_int_operand" "")
+			 (match_operand:SI 3 "const_int_operand" "")))]
+  "TARGET_ALLEGREX_EXT"
+  "ext\t%0,%1,%3,%2"
+  [(set_attr "type"	"arith")
+   (set_attr "mode"	"SI")])
+
+(define_insn "insv_allegrex_insn"
+  [(set (zero_extract:SI (match_operand:SI 0 "register_operand" "+d")
+			 (match_operand:SI 1 "const_int_operand" "")
+			 (match_operand:SI 2 "const_int_operand" ""))
+	(match_operand:SI 3 "reg_or_0_operand" "dJ"))]
+  "TARGET_ALLEGREX_EXT"
+  "ins\t%0,%z3,%2,%1"
+  [(set_attr "type"	"arith")
+   (set_attr "mode"	"SI")])
+
+;; x & (2**n - 1) for n > 16, which andi cannot encode.
+(define_insn "*andsi3_allegrex_ext"
+  [(set (match_operand:SI 0 "register_operand" "=d")
+	(and:SI (match_operand:SI 1 "register_operand" "d")
+		(match_operand:SI 2 "const_int_operand" "")))]
+  "TARGET_ALLEGREX_EXT && allegrex_low_mask_p (operands[2])"
+  "*
+{
+  operands[3] = GEN_INT (exact_log2 ((INTVAL (operands[2]) & 0xffffffff) + 1));
+  return \"ext\\t%0,%1,0,%3\";
+}"
+  [(set_attr "type"	"arith")
+   (set_attr "mode"	"SI")])
+
+;; Multiply-accumulate (-mmadd).
+
+(define_insn "maddsi_allegrex"
+  [(set (match_operand:SI 0 "register_operand" "+l")
+	(plus:SI (mult:SI (match_operand:SI 1 "register_operand" "d")
+			  (match_operand:SI 2 "register_operand" "d"))
+		 (match_dup 0)))
+   (clobber (match_scratch:SI 3 "=h"))]
+  "TARGET_ALLEGREX_MADD"
+  "madd\t%1,%2"
+  [(set_attr "type"	"imadd")
+   (set_attr "mode"	"SI")])
+
+(define_insn "msubsi_allegrex"
+  [(set (match_operand:SI 0 "register_operand" "+l")
+	(minus:SI (match_dup 0)
+		  (mult:SI (match_operand:SI 1 "register_operand" "d")
+			   (match_operand:SI 2 "register_operand" "d"))))
+   (clobber (match_scratch:SI 3 "=h"))]
+  "TARGET_ALLEGREX_MADD"
+  "msub\t%1,%2"
+  [(set_attr "type"	"imadd")
+   (set_attr "mode"	"SI")])
